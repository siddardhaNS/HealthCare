{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform API",
    "version": "0.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "region": {
            "type": "string",
            "example": "bom1"
          },
          "version": {
            "type": "string",
            "example": "0.0.0"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "region",
          "version",
          "time"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string",
                "example": "Resource not found"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "OtpIntentRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+91[6-9]\\d{9}$",
            "example": "+919876543210"
          },
          "channel": {
            "$ref": "#/components/schemas/OtpChannel"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          }
        },
        "required": [
          "phone",
          "channel"
        ]
      },
      "OtpChannel": {
        "type": "string",
        "enum": [
          "whatsapp",
          "sms"
        ]
      },
      "Language": {
        "type": "string",
        "enum": [
          "en",
          "te",
          "hi"
        ],
        "default": "en"
      },
      "WhatsappOptinRequest": {
        "type": "object",
        "properties": {
          "consentVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "consentVersion"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppRole"
            }
          },
          "aal": {
            "type": "string",
            "enum": [
              "aal1",
              "aal2"
            ]
          }
        },
        "required": [
          "userId",
          "phone",
          "roles",
          "aal"
        ]
      },
      "AppRole": {
        "type": "string",
        "enum": [
          "super_admin",
          "operations",
          "community_desk",
          "support",
          "doctor",
          "pharmacy",
          "lab",
          "hospital",
          "crew",
          "phlebotomist",
          "companion",
          "rider"
        ]
      },
      "LeadCreated": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "example": "L-7K3Q9P"
          }
        },
        "required": [
          "ref"
        ]
      },
      "LeadRequest": {
        "type": "object",
        "properties": {
          "orgType": {
            "type": "string",
            "enum": [
              "gated",
              "apartment",
              "township",
              "senior_home",
              "employer",
              "family"
            ]
          },
          "orgName": {
            "type": "string",
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "area": {
            "type": "string",
            "maxLength": 80
          },
          "pin": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "towers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "seniorShare": {
            "type": "string",
            "enum": [
              "unknown",
              "lt10",
              "10to25",
              "25to50",
              "gt50"
            ],
            "default": "unknown"
          },
          "onsite": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "guard",
                "clinic",
                "ambulance",
                "pharmacy"
              ]
            },
            "maxItems": 4,
            "default": []
          },
          "contactName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "contactRole": {
            "type": "string",
            "enum": [
              "association",
              "committee",
              "facility",
              "builder",
              "hr",
              "family",
              "resident",
              "other"
            ]
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+91[6-9]\\d{9}$",
            "example": "+919876543210"
          },
          "email": {
            "type": "string",
            "maxLength": 160,
            "format": "email"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "consult",
                "pharmacy",
                "lab",
                "companion",
                "sos"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "plan": {
            "type": "string",
            "enum": [
              "essentials",
              "complete",
              "custom",
              "unsure"
            ]
          },
          "walkthrough": {
            "type": "string",
            "enum": [
              "this_week",
              "this_weekend",
              "next_week",
              "call_me"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "consentVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "website": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "orgType",
          "city",
          "size",
          "contactName",
          "contactRole",
          "phone",
          "email",
          "services",
          "plan",
          "walkthrough",
          "consent",
          "consentVersion"
        ]
      },
      "LeadList": {
        "type": "object",
        "properties": {
          "leads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Lead"
            }
          }
        },
        "required": [
          "leads"
        ]
      },
      "Lead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ref": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "walkthrough_booked",
              "live"
            ]
          },
          "orgType": {
            "type": "string",
            "enum": [
              "gated",
              "apartment",
              "township",
              "senior_home",
              "employer",
              "family"
            ]
          },
          "orgName": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": "string"
          },
          "area": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": "integer"
          },
          "contactName": {
            "type": "string"
          },
          "contactRole": {
            "type": "string",
            "enum": [
              "association",
              "committee",
              "facility",
              "builder",
              "hr",
              "family",
              "resident",
              "other"
            ]
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "consult",
                "pharmacy",
                "lab",
                "companion",
                "sos"
              ]
            }
          },
          "plan": {
            "type": "string",
            "enum": [
              "essentials",
              "complete",
              "custom",
              "unsure"
            ]
          },
          "walkthrough": {
            "type": "string",
            "enum": [
              "this_week",
              "this_weekend",
              "next_week",
              "call_me"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "ref",
          "createdAt",
          "status",
          "orgType",
          "orgName",
          "city",
          "area",
          "size",
          "contactName",
          "contactRole",
          "phone",
          "email",
          "services",
          "plan",
          "walkthrough",
          "notes"
        ]
      },
      "LeadStatusUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "walkthrough_booked",
              "live"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "API is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp-intent": {
      "post": {
        "operationId": "createOtpIntent",
        "tags": [
          "auth"
        ],
        "summary": "Choose the OTP channel before calling Supabase signInWithOtp",
        "description": "Remembers the channel for the next OTP to this phone. The WhatsApp opt-in is recorded only after sign-in (POST /auth/whatsapp-optin), once the phone is verified.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpIntentRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Recorded"
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/whatsapp-optin": {
      "post": {
        "operationId": "recordWhatsappOptin",
        "tags": [
          "auth"
        ],
        "summary": "Record WhatsApp consent for the verified phone of the signed-in user",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatsappOptinRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Recorded"
          },
          "400": {
            "description": "No verified phone on this account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/leads": {
      "post": {
        "operationId": "createLead",
        "tags": [
          "leads"
        ],
        "summary": "Landing-site sign-up (community, organisation or family)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadCreated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listLeads",
        "tags": [
          "leads"
        ],
        "summary": "Leads for the console, newest first",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "contacted",
                "walkthrough_booked",
                "live"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Leads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadList"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/leads/{id}": {
      "patch": {
        "operationId": "updateLeadStatus",
        "tags": [
          "leads"
        ],
        "summary": "Move a lead through new → contacted → walkthrough booked → live",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lead"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such lead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
