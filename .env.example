# Server-side secrets for the API and scripts. Copy to .env (git-ignored).
# Production values live only in Vercel / Supabase encrypted env vars.
# App-specific public values: apps/*/.env.example.

# Supabase (local: `pnpm supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
# Secret key (sb_secret_…). Server only (API + scripts), never in apps. The API uses it to push live SOS
# updates over Realtime; without it the apps fall back to polling. Required in production.
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Connections per API instance (default 5). Production: keep instances × this under the Supabase pooler's limit.
DB_POOL_MAX=
# Only if the local Supabase CLI stack signs tokens with HS256. Never in production.
SUPABASE_JWT_SECRET=

# Supabase Send SMS hook (Standard Webhooks). Same value in supabase/.env for `supabase start`.
# Generate: echo "v1,whsec_$(openssl rand -base64 32)"
SEND_SMS_HOOK_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
OTP_FALLBACK_KEY=
# Any long random string: openssl rand -hex 32
PHONE_HASH_KEY=
# 32 random bytes, base64: openssl rand -base64 32 (encrypts clinical notes)
FIELD_ENC_KEY=

# log = print "would send" lines (no codes); live = real WhatsApp + MSG91
MESSAGING_MODE=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# DLT template ids for the SOS alerts' SMS fallback (plan §13)
MSG91_SOS_FAMILY_TEMPLATE_ID=
MSG91_SOS_DESK_TEMPLATE_ID=
MSG91_SOS_GATE_TEMPLATE_ID=

# Upstash Redis (required in production; local dev falls back to in-process)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Later phases
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret set on the Razorpay dashboard webhook (not the API key secret)
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
