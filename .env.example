# Copy to .env (git-ignored). Use sandbox/test keys until launch.
# Production secrets live only in Vercel and Supabase encrypted env vars.

# Supabase (local: values printed by `pnpm supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public values the apps read
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Providers (Phase 1 accounts; fill in as they are approved)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
MSG91_AUTH_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
